<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Identidad FanVerse -->
    <Color x:Key="CarbonColor">#101014</Color>
    <Color x:Key="MarfilColor">#F4EDE1</Color>
    <Color x:Key="RojoColor">#C12D43</Color>
    <Color x:Key="AmarilloColor">#F4C95D</Color>

    <!-- Superficies secundarias -->
    <Color x:Key="PanelColor">#1C1C22</Color>
    <Color x:Key="BordeColor">#35353D</Color>

    <!-- Pinceles reutilizables -->
    <SolidColorBrush x:Key="CarbonBrush"
                     Color="{StaticResource CarbonColor}"/>

    <SolidColorBrush x:Key="MarfilBrush"
                     Color="{StaticResource MarfilColor}"/>

    <SolidColorBrush x:Key="RojoBrush"
                     Color="{StaticResource RojoColor}"/>

    <SolidColorBrush x:Key="AmarilloBrush"
                     Color="{StaticResource AmarilloColor}"/>

    <SolidColorBrush x:Key="PanelBrush"
                     Color="{StaticResource PanelColor}"/>

    <SolidColorBrush x:Key="BordeBrush"
                     Color="{StaticResource BordeColor}"/>

</ResourceDictionary>