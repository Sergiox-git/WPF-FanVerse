<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="VentanaFanVerse" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="SuperficieDialogo" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <Style x:Key="TituloDialogo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="EstadoDialogo" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AmarilloBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="EtiquetaCampoDialogo" TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <ControlTemplate x:Key="MarcoCampoDialogo" TargetType="Control">
        <Border x:Name="Marco"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="7"
                Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Marco" Property="BorderBrush"
                        Value="{DynamicResource AmarilloBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Marco" Property="Opacity" Value="0.55"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="CampoDialogo" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextoDialogo" TargetType="TextBox" BasedOn="{StaticResource CampoDialogo}">
        <Setter Property="Template" Value="{StaticResource MarcoCampoDialogo}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource MarfilBrush}"/>
    </Style>

    <Style x:Key="ContrasenaDialogo" TargetType="PasswordBox"
           BasedOn="{StaticResource CampoDialogo}">
        <Setter Property="Template" Value="{StaticResource MarcoCampoDialogo}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource MarfilBrush}"/>
    </Style>

    <Style x:Key="OpcionDialogo" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fila" Background="Transparent"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fila" Property="Background"
                                    Value="{DynamicResource BordeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AmarilloBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectorDialogo" TargetType="ComboBox" BasedOn="{StaticResource CampoDialogo}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource OpcionDialogo}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Abrir"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      Foreground="{TemplateBinding Foreground}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7">
                                        <Path Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,13,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,28,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Abrir}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BordeBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Abrir" Property="BorderBrush"
                                    Value="{DynamicResource AmarilloBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonDialogo" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MarfilBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BordeBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Cuerpo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cuerpo" Property="BorderBrush"
                                    Value="{DynamicResource MarfilBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Cuerpo" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cuerpo" Property="BorderBrush"
                                    Value="{DynamicResource AmarilloBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Cuerpo" Property="Opacity" Value="0.50"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrincipalDialogo" TargetType="Button" BasedOn="{StaticResource BotonDialogo}">
        <Setter Property="Background" Value="{DynamicResource RojoBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RojoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</ResourceDictionary>
