<Window x:Class="FanVerse.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="FanVerse · Acceso"
        Width="840" Height="510" MinWidth="650" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=CorreoTextBox}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SuperficieDialogo}" Padding="24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PanelColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource CarbonColor}" Offset="0.52"/>
                    <GradientStop Color="#3F1520" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Image Source="/Assets/Images/logo_blanco.png"
                       MaxWidth="240" Height="112" Stretch="Uniform"
                       AutomationProperties.Name="FanVerse"/>
                <Border Width="44" Height="3" CornerRadius="2" Margin="0,18,0,0"
                        Background="{StaticResource RojoBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SuperficieDialogo}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center">
                <StackPanel Margin="30,24" MaxWidth="350" VerticalAlignment="Center">
                    <TextBlock Text="Iniciar sesión" Style="{StaticResource TituloDialogo}"
                               Margin="0,0,0,24"/>

                    <Label Content="_Correo electrónico" Style="{StaticResource EtiquetaCampoDialogo}"
                           Target="{Binding ElementName=CorreoTextBox}"/>
                    <TextBox x:Name="CorreoTextBox" Style="{StaticResource TextoDialogo}"
                             Margin="0,0,0,16"/>

                    <Label Content="C_ontraseña" Style="{StaticResource EtiquetaCampoDialogo}"
                           Target="{Binding ElementName=ContrasenaPasswordBox}"/>
                    <PasswordBox x:Name="ContrasenaPasswordBox"
                                 Style="{StaticResource ContrasenaDialogo}"
                                 Margin="0,0,0,20"/>

                    <Button x:Name="EntrarButton" Content="Entrar"
                            Style="{StaticResource BotonPrincipalDialogo}"
                            IsDefault="True" Click="Entrar_Click"/>

                    <TextBlock x:Name="MensajeTextBlock" Style="{StaticResource EstadoDialogo}"
                               Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
