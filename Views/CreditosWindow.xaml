<Window x:Class="FanVerse.Views.CreditosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="Créditos de FanVerse" Width="460"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource SuperficieDialogo}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Text="Créditos" Style="{StaticResource TituloDialogo}"/>

            <Border Background="{StaticResource CarbonBrush}" CornerRadius="8"
                    Padding="12" Margin="0,18,0,14" HorizontalAlignment="Left">
                <Image Source="/Assets/Images/tmdb_logo.png" Width="132" Height="44"
                       Stretch="Uniform" AutomationProperties.Name="The Movie Database"/>
            </Border>

            <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                       Foreground="{StaticResource MarfilBrush}" TextWrapping="Wrap"
                       Language="en-US"/>

            <Button Content="Cerrar" Style="{StaticResource BotonDialogo}"
                    IsCancel="True" IsDefault="True"
                    HorizontalAlignment="Right" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
