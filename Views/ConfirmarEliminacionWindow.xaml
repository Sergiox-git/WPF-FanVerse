<Window x:Class="FanVerse.Views.ConfirmarEliminacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="Confirmar eliminación"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource SuperficieDialogo}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Text="¿Eliminar del catálogo?" Style="{StaticResource TituloDialogo}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="MensajeTextBlock" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotonDialogo}"
                        IsCancel="True" IsDefault="True" Margin="0,0,8,0"/>
                <Button Content="Eliminar" Style="{StaticResource BotonPrincipalDialogo}"
                        Click="Eliminar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
