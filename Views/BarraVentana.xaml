<UserControl x:Class="FanVerse.Views.BarraVentana"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Language="es-ES">
    <UserControl.Resources>
        <Style x:Key="BotonVentana" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MarfilBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Superficie" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Superficie" Property="Background" Value="{DynamicResource BordeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Superficie" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="Superficie" Property="BorderBrush" Value="{DynamicResource AmarilloBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BordeBrush}"
            BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Margin="0,0,5,0">
                <Button Click="Minimizar_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonVentana}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="NoResize">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3"/>
                </Button>
                <Button Click="Maximizar_Click" ToolTip="Maximizar o restaurar"
                        AutomationProperties.Name="Maximizar o restaurar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonVentana}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="NoResize">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResizeMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="CanMinimize">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 0,0 H 10 V 10 H 0 Z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="Maximized">
                                        <Setter Property="Data" Value="M 0,3 H 7 V 10 H 0 Z M 3,3 V 0 H 10 V 7 H 7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Click="Cerrar_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotonVentana}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Superficie" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Superficie" Property="Background" Value="{DynamicResource RojoBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Superficie" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="Superficie" Property="BorderBrush" Value="{DynamicResource AmarilloBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1.3"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{StaticResource MarfilBrush}"
                       FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="16,0,10,0"/>
        </DockPanel>
    </Border>
</UserControl>
