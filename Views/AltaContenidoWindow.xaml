<Window x:Class="FanVerse.Views.AltaContenidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir película o serie"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Título"/>
        <TextBox x:Name="TituloTextBox"
                 MaxLength="200"
                 Margin="0,4,0,12"/>

        <TextBlock Text="Tipo"/>
        <ComboBox x:Name="TipoComboBox"
                  SelectedValuePath="Tag"
                  Margin="0,4,0,12">
            <ComboBoxItem Content="Película" Tag="pelicula"/>
            <ComboBoxItem Content="Serie" Tag="serie"/>
        </ComboBox>

        <TextBlock Text="Sinopsis"/>
        <TextBox x:Name="SinopsisTextBox"
                 Height="80"
                 MaxLength="10000"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,4,0,12"/>

        <TextBlock x:Name="EstadoTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Button x:Name="GuardarButton"
                Content="Guardar"
                IsDefault="True"
                HorizontalAlignment="Right"
                Padding="16,6"
                Click="Guardar_Click"/>
    </StackPanel>
</Window>