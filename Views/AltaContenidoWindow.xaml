<Window x:Class="FanVerse.Views.AltaContenidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="Añadir película o serie" Width="520"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TituloTextBox}">
    <Border Style="{StaticResource SuperficieDialogo}" Margin="20" Padding="24">
        <StackPanel>
            <TextBlock Style="{StaticResource TituloDialogo}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Margin="0,0,0,22"/>

            <Label Content="_Título" Style="{StaticResource EtiquetaCampoDialogo}"
                   Target="{Binding ElementName=TituloTextBox}"/>
            <TextBox x:Name="TituloTextBox" MaxLength="200"
                     Style="{StaticResource TextoDialogo}" Margin="0,0,0,14"/>

            <Label Content="T_ipo" Style="{StaticResource EtiquetaCampoDialogo}"
                   Target="{Binding ElementName=TipoComboBox}"/>
            <ComboBox x:Name="TipoComboBox" SelectedValuePath="Tag"
                      Style="{StaticResource SelectorDialogo}" Margin="0,0,0,14">
                <ComboBoxItem Content="Película" Tag="pelicula"/>
                <ComboBoxItem Content="Serie" Tag="serie"/>
            </ComboBox>

            <Label Content="_Sinopsis" Style="{StaticResource EtiquetaCampoDialogo}"
                   Target="{Binding ElementName=SinopsisTextBox}"/>
            <TextBox x:Name="SinopsisTextBox" Style="{StaticResource TextoDialogo}"
                     Height="100" MaxLength="10000" AcceptsReturn="True"
                     VerticalContentAlignment="Top" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock x:Name="EstadoTextBlock" Style="{StaticResource EstadoDialogo}"
                       Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotonDialogo}"
                        IsCancel="True" Margin="0,0,8,0"
                        IsEnabled="{Binding IsEnabled, ElementName=GuardarButton}"/>
                <Button x:Name="GuardarButton" Content="Guardar"
                        Style="{StaticResource BotonPrincipalDialogo}"
                        IsDefault="True" Click="Guardar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
