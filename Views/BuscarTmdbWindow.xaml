<Window x:Class="FanVerse.Views.BuscarTmdbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="Buscar en TMDB"
        Width="1040" Height="700" MinWidth="730" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ConsultaTextBox}">

    <Window.Resources>
        <Style x:Key="TarjetaResultado" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MarfilBrush}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tarjeta"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="2" CornerRadius="9" Padding="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource MarfilBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource RojoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource AmarilloBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="TituloVentanaTextBlock" Style="{StaticResource TituloDialogo}" Margin="0,0,0,5"/>
            <TextBlock x:Name="AyudaTextBlock" Foreground="{StaticResource MarfilBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="TipoComboBox" Style="{StaticResource SelectorDialogo}"
                      SelectedValuePath="Tag"
                      AutomationProperties.Name="Tipo de contenido">
                <ComboBoxItem x:Name="TodosItem" Content="Todos" Tag="todos"/>
                <ComboBoxItem Content="Película" Tag="pelicula"/>
                <ComboBoxItem Content="Serie" Tag="serie"/>
            </ComboBox>

            <TextBox x:Name="ConsultaTextBox" Grid.Column="1"
                     Style="{StaticResource TextoDialogo}" Margin="10,0"
                     MaxLength="200" AutomationProperties.Name="Título que quieres buscar"/>

            <Button x:Name="BuscarButton" Grid.Column="2" Content="Buscar"
                    Style="{StaticResource BotonPrincipalDialogo}"
                    IsDefault="True" Click="Buscar_Click"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="2"
                   Style="{StaticResource EstadoDialogo}" Margin="0,10,0,12"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultadosListBox"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TarjetaResultado}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ResultadosListBox_SelectionChanged"
                     AutomationProperties.Name="Resultados de búsqueda">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="156" ToolTip="{Binding Titulo}"
                                    AutomationProperties.Name="{Binding Titulo}">
                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource PortadaFanVerse}"/>
                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,7,0,2"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource SuperficieDialogo}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Ficha del título" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Selecciona un resultado para ver su ficha." TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ResultadosListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel DataContext="{Binding SelectedItem, ElementName=ResultadosListBox}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource PortadaFanVerse}"/>
                            <TextBlock Text="{Binding Titulo}" FontSize="22" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,14,0,6"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding TipoTexto}" Margin="0,0,8,4"/>
                                <TextBlock Text="·" Margin="0,0,8,4"/>
                                <TextBlock Text="{Binding FechaTexto}" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding OrigenTexto, StringFormat=Origen: {0}}"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding NotaTexto}" Foreground="{StaticResource AmarilloBrush}"/>
                            <TextBlock Text="Sinopsis" FontWeight="SemiBold" Margin="0,14,0,5"/>
                            <TextBlock Text="{Binding SinopsisTexto}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cerrar" Style="{StaticResource BotonDialogo}"
                        IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ImportarButton" Content="Añadir al catálogo"
                        Style="{StaticResource BotonPrincipalDialogo}"
                        IsEnabled="False" Click="Importar_Click"/>
            </StackPanel>
            <TextBlock x:Name="MarcaCatalogoTextBlock" Style="{StaticResource EstadoDialogo}"
                       AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</Window>
