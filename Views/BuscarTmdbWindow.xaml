<Window x:Class="FanVerse.Views.BuscarTmdbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VentanaFanVerse}"
        Title="Buscar en TMDB"
        Width="970" Height="640" MinWidth="700" MinHeight="510"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ConsultaTextBox}">

    <Window.Resources>
        <Style x:Key="TarjetaResultado" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource MarfilBrush}"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tarjeta"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BordeBrush}"
                                BorderThickness="2" CornerRadius="9" Padding="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource MarfilBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource RojoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush"
                                        Value="{StaticResource AmarilloBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Buscar en TMDB" Style="{StaticResource TituloDialogo}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="TipoComboBox" Style="{StaticResource SelectorDialogo}"
                      SelectedIndex="0" SelectedValuePath="Tag"
                      AutomationProperties.Name="Tipo de contenido">
                <ComboBoxItem Content="Película" Tag="pelicula"/>
                <ComboBoxItem Content="Serie" Tag="serie"/>
            </ComboBox>

            <TextBox x:Name="ConsultaTextBox" Grid.Column="1"
                     Style="{StaticResource TextoDialogo}" Margin="10,0"
                     AutomationProperties.Name="Título que quieres buscar"/>

            <Button x:Name="BuscarButton" Grid.Column="2" Content="Buscar"
                    Style="{StaticResource BotonPrincipalDialogo}"
                    IsDefault="True" Click="Buscar_Click"/>
        </Grid>

        <TextBlock x:Name="EstadoTextBlock" Grid.Row="2"
                   Style="{StaticResource EstadoDialogo}" Margin="0,10,0,12"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultadosListBox"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TarjetaResultado}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="ResultadosListBox_SelectionChanged"
                     AutomationProperties.Name="Resultados de TMDB">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="106" ToolTip="{Binding Titulo}"
                                    AutomationProperties.Name="{Binding Titulo}">
                            <Grid Height="159" Background="{StaticResource CarbonBrush}"
                                  ClipToBounds="True">
                                <TextBlock Text="Sin carátula" FontSize="11"
                                           Foreground="{StaticResource MarfilBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                            </Grid>
                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,7,0,2"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource SuperficieDialogo}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Vista previa" FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Selecciona una ficha para ver su sinopsis."
                                   Foreground="{StaticResource MarfilBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ResultadosListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ResultadosListBox}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Width="100" Height="150" HorizontalAlignment="Left"
                                  Background="{StaticResource CarbonBrush}" ClipToBounds="True">
                                <TextBlock Text="Sin carátula" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding SelectedItem.PosterUrl, ElementName=ResultadosListBox}"
                                       Stretch="UniformToFill"/>
                            </Grid>
                            <TextBlock x:Name="TituloTextBlock" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="FechaTextBlock"
                                       Foreground="{StaticResource AmarilloBrush}" Margin="0,4,0,8"/>
                            <TextBlock x:Name="SinopsisTextBlock" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="4" Content="Importar al catálogo"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="Importar_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource BotonPrincipalDialogo}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=ResultadosListBox}"
                                     Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
