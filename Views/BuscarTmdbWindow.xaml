<Window x:Class="FanVerse.Views.BuscarTmdbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar en TMDB"
        Width="720" Height="450"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <ComboBox x:Name="TipoComboBox"
                      Width="115"
                      SelectedIndex="0"
                      SelectedValuePath="Tag">
                <ComboBoxItem Content="Película" Tag="pelicula"/>
                <ComboBoxItem Content="Serie" Tag="serie"/>
            </ComboBox>

            <TextBox x:Name="ConsultaTextBox"
                     Width="250"
                     Margin="8,0"/>

            <Button x:Name="BuscarButton"
                    Content="Buscar"
                    Padding="12,4"
                    IsDefault="True"
                    Click="Buscar_Click"/>
        </StackPanel>

        <TextBlock x:Name="EstadoTextBlock"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Button Content="Importar al catálogo"
                DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Padding="12,5"
                Click="Importar_Click"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultadosListBox"
                     DisplayMemberPath="Titulo"
                     SelectionChanged="ResultadosListBox_SelectionChanged"/>

            <ScrollViewer Grid.Column="1"
                          Margin="16,0,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TituloTextBlock"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="FechaTextBlock" Margin="0,4,0,8"/>
                    <TextBlock x:Name="SinopsisTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>