<Window x:Class="FanVerse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FanVerse"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource CarbonBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú lateral -->
            <ColumnDefinition Width="240"/>

            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!-- MENÚ LATERAL            -->
        <!-- ======================= -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <!-- Perfil inferior -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,15"
                               Background="{StaticResource BordeBrush}"/>

                    <TextBlock Text="MI CUENTA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,5,0,15"/>

                    <Button Content="Mi perfil"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="Cerrar sesión"
                            Style="{StaticResource SidebarButtonStyle}"/>

                </StackPanel>

                <!-- Navegación -->
                <StackPanel>

                    <!-- Logotipo oficial -->
                    <Image Source="/Assets/Images/logo_blanco.png"
                           Width="200"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                    <TextBlock Text="NAVEGACIÓN"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,0,0,15"/>

                    <!-- INICIO -->
                    <Button Content="Inicio"
                            x:Name="BtnInicio"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Inicio_Click"/>

                    <!-- MI CATÁLOGO -->
                    <Button Content="Mi catálogo"
                            x:Name="BtnCatalogo"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Catalogo_Click"/>

                    <!-- RESEÑAS -->
                    <Button Content="Reseñas"
                            x:Name="BtnResenas"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Resenas_Click"/>

                    <Button Content="Créditos"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Creditos_Click"/>
                    

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================= -->
        <!-- CONTENIDO PRINCIPAL     -->
        <!-- ======================= -->

        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FANVERSE"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource MarfilBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Bienvenido a FanVerse"
                           Foreground="{StaticResource MarfilBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- ======================= -->
            <!-- PESTAÑAS PRINCIPALES    -->
            <!-- ======================= -->

            <TabControl x:Name="MainTabs"
            Grid.Row="1"
            SelectedIndex="0"
            Style="{StaticResource HiddenTabsStyle}">

                <!-- INICIO: TMDB -->
                <TabItem Header="Inicio">
                    <TabItem.Resources>
                        <ItemsPanelTemplate x:Key="FilaRanking">
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>

                        <DataTemplate x:Key="TarjetaRanking">
                            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BordeBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,12,6">
                                <StackPanel Width="144">
                                    <Grid Height="216"
                          Background="{StaticResource CarbonBrush}"
                          ClipToBounds="True">
                                        <TextBlock Text="Sin carátula"
                                   Foreground="{StaticResource MarfilBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                        <Image Source="{Binding PosterUrl}"
                               Stretch="UniformToFill"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Titulo}"
                               ToolTip="{Binding Titulo}"
                               Foreground="{StaticResource MarfilBrush}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,4"/>

                                    <TextBlock Text="{Binding Valoracion,
                                              StringFormat={}{0:0.0}/10,
                                              TargetNullValue='Sin valoración'}"
                               Foreground="{StaticResource AmarilloBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TabItem.Resources>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">
                            <TextBlock Text="Descubre tu próxima historia"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"/>

                            <Button x:Name="ActualizarInicioButton"
                    Content="Actualizar rankings"
                    HorizontalAlignment="Left"
                    Background="{StaticResource PanelBrush}"
                    Foreground="{StaticResource MarfilBrush}"
                    Padding="12,6"
                    Margin="0,12,0,0"
                    Click="ActualizarInicio_Click"/>

                            <TextBlock x:Name="EstadoInicioTextBlock"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

                            <TextBlock Text="Películas mejor valoradas"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,20,0,10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PeliculasRankingItems"
                              ItemsPanel="{StaticResource FilaRanking}"
                              ItemTemplate="{StaticResource TarjetaRanking}"/>
                            </ScrollViewer>

                            <TextBlock Text="Series mejor valoradas"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,24,0,10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SeriesRankingItems"
                              ItemsPanel="{StaticResource FilaRanking}"
                              ItemTemplate="{StaticResource TarjetaRanking}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- MI CATÁLOGO: FIREBASE -->
                <TabItem Header="Mi catálogo">
                    <TabItem.Resources>
                        <Style x:Key="AccionCatalogo" TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource MarfilBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
                            <Setter Property="Padding" Value="14,7"/>
                            <Setter Property="MinHeight" Value="36"/>
                            <Setter Property="Margin" Value="0,0,8,6"/>
                        </Style>
                    </TabItem.Resources>

                    <Grid Margin="24" Background="{StaticResource CarbonBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Mi catálogo"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="Buscar en TMDB"
                        Style="{StaticResource AccionCatalogo}"
                        Background="{StaticResource RojoBrush}"
                        Foreground="White"
                        Click="BuscarTmdb_Click"/>

                                <Button Content="+ Añadir manualmente"
                        Style="{StaticResource AccionCatalogo}"
                        Click="AnadirContenido_Click"/>

                                <Button Content="Editar"
                        Style="{StaticResource AccionCatalogo}"
                        Click="EditarContenido_Click"/>

                                <Button x:Name="EliminarContenidoButton"
                        Content="Eliminar"
                        Style="{StaticResource AccionCatalogo}"
                        Click="EliminarContenido_Click"/>
                            </WrapPanel>

                            <TextBlock x:Name="EstadoCatalogoTextBlock"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="CatalogoListBox"
                 Grid.Row="1"
                 SelectedValuePath="Key"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,12,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tarjeta"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BordeBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource MarfilBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource AmarilloBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource RojoBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="144">
                                        <Grid Height="216"
                              Background="{StaticResource CarbonBrush}"
                              ClipToBounds="True">
                                            <TextBlock Text="Sin carátula"
                                       Foreground="{StaticResource MarfilBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                            <Image Source="{Binding Value.PosterUrl}"
                                   Stretch="UniformToFill"
                                   IsHitTestVisible="False"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Value.Titulo}"
                                   Foreground="{StaticResource MarfilBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Value.Titulo}"
                                   Margin="0,8,0,5"/>

                                        <Border Background="{StaticResource CarbonBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Padding="7,3">
                                            <TextBlock x:Name="EtiquetaTipo"
                                       Text="Sin tipo"
                                       FontSize="11"
                                       Foreground="{StaticResource AmarilloBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Value.Tipo}" Value="pelicula">
                                            <Setter TargetName="EtiquetaTipo" Property="Text" Value="Película"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Value.Tipo}" Value="serie">
                                            <Setter TargetName="EtiquetaTipo" Property="Text" Value="Serie"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- RESEÑAS PÚBLICAS -->
                <TabItem Header="Reseñas">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="RESEÑAS DE LA COMUNIDAD"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Descubre las opiniones de otros usuarios."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <Button Content="+ Escribir reseña"
                                    Width="180"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RojoBrush}"
                                    Foreground="White"/>


                        </StackPanel>

                    </Grid>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>
