<Window x:Class="FanVerse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FanVerse"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource CarbonBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú lateral -->
            <ColumnDefinition Width="240"/>

            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!-- MENÚ LATERAL            -->
        <!-- ======================= -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <!-- Perfil inferior -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,15"
                               Background="{StaticResource BordeBrush}"/>

                    <TextBlock Text="MI CUENTA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,5,0,15"/>

                    <Button Content="Mi perfil"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="Cerrar sesión"
                            Style="{StaticResource SidebarButtonStyle}"/>

                </StackPanel>

                <!-- Navegación -->
                <StackPanel>

                    <!-- Logotipo oficial -->
                    <Image Source="/Assets/Images/logo_blanco.png"
                           Width="200"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                    <TextBlock Text="NAVEGACIÓN"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,0,0,15"/>

                    <!-- INICIO -->
                    <Button Content="Inicio"
                            x:Name="BtnInicio"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Inicio_Click"/>

                    <!-- MI CATÁLOGO -->
                    <Button Content="Mi catálogo"
                            x:Name="BtnCatalogo"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Catalogo_Click"/>

                    <!-- RESEÑAS -->
                    <Button Content="Reseñas"
                            x:Name="BtnResenas"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Resenas_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================= -->
        <!-- CONTENIDO PRINCIPAL     -->
        <!-- ======================= -->

        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FANVERSE"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource MarfilBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Bienvenido a FanVerse"
                           Foreground="{StaticResource MarfilBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- ======================= -->
            <!-- PESTAÑAS PRINCIPALES    -->
            <!-- ======================= -->

            <TabControl x:Name="MainTabs"
            Grid.Row="1"
            SelectedIndex="0"
            Style="{StaticResource HiddenTabsStyle}">

                <!-- INICIO: TMDB -->
                <TabItem Header="Inicio">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="DESCUBRE TU PRÓXIMA HISTORIA"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Explora películas y series de TMDB."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <TextBox Height="40"
                                     Width="400"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     Text="Buscar películas y series..."/>

                        </StackPanel>

                    </Grid>

                </TabItem>

                <!-- MI CATÁLOGO: FIREBASE -->
                <TabItem Header="Mi catálogo">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="MI CATÁLOGO"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Gestiona tus películas y series guardadas."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <Button Content="+ Añadir película o serie"
                                    Width="220"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RojoBrush}"
                                    Foreground="White"/>

                            <TextBlock x:Name="EstadoCatalogoTextBlock"
                                        Foreground="{StaticResource MarfilBrush}"
                                        Margin="0,12,0,6"
                                        TextWrapping="Wrap" />

                            <ListBox x:Name="CatalogoListBox"
                                        DisplayMemberPath="Value.Titulo"
                                        SelectedValuePath="Key"
                                        MaxHeight="320" />

                        </StackPanel>

                    </Grid>

                </TabItem>

                <!-- MIS RESEÑAS -->
                <TabItem Header="Reseñas">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMNA IZQUIERDA: FORMULARIO -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">

                            <TextBlock Text="MIS RESEÑAS"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Tus valoraciones privadas de películas y series."
                                       FontSize="14"
                                       Foreground="{StaticResource MarfilBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Contenido"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="ContenidoComboBox"
                                      DisplayMemberPath="Value.Titulo"
                                      SelectedValuePath="Key"
                                      Height="32"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="Puntuación (1-10)"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="PuntuacionTextBox"
                                     Height="32"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="Comentario"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="ComentarioTextBox"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="BtnNuevaResena"
                                        Content="Nuevo"
                                        Width="90" Height="36"
                                        Margin="0,0,8,0"
                                        Click="NuevaResena_Click"/>
                                <Button x:Name="BtnGuardarResena"
                                        Content="Guardar"
                                        Width="90" Height="36"
                                        Margin="0,0,8,0"
                                        Background="{StaticResource RojoBrush}"
                                        Foreground="White"
                                        Click="GuardarResena_Click"/>
                                <Button x:Name="BtnEliminarResena"
                                        Content="Eliminar"
                                        Width="90" Height="36"
                                        Click="EliminarResena_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="EstadoResenaTextBlock"
                                       Foreground="{StaticResource AmarilloBrush}"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                        <!-- COLUMNA DERECHA: LISTA -->
                        <StackPanel Grid.Column="1">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="LISTA DE MIS RESEÑAS"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MarfilBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"/>
                                <Button x:Name="BtnActualizarResenas"
                                        Content="Actualizar"
                                        Width="100" Height="30"
                                        Click="ActualizarResenas_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="EstadoListaResenasTextBlock"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>

                            <ListBox x:Name="MisResenasListBox"
                                     MaxHeight="420"
                                     DisplayMemberPath="Value.TituloAlCrear"
                                     SelectedValuePath="Key"
                                     SelectionChanged="MisResenasListBox_SelectionChanged"/>

                        </StackPanel>

                    </Grid>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>
