<Window x:Class="FanVerse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FanVerse.Views"
        Style="{StaticResource VentanaFanVerse}"
        Title="FanVerse"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource CarbonBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="FilaTmdb">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TarjetaTmdb">
            <Border Style="{StaticResource SuperficieDialogo}" Padding="8" Margin="0,0,10,6">
                <StackPanel Width="156">
                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource PortadaFanVerse}"/>
                    <TextBlock Text="{Binding Titulo}" ToolTip="{Binding Titulo}"
                               Foreground="{StaticResource MarfilBrush}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,7,0,3"/>
                    <TextBlock Text="{Binding Valoracion, StringFormat={}{0:0.0}/10, TargetNullValue='Sin valoración'}"
                               Foreground="{StaticResource AmarilloBrush}" Margin="0,0,0,7"/>
                    <Button Content="Importar" Style="{StaticResource BotonDialogo}"
                            MinHeight="30" Padding="8,4" Click="ImportarFicha_Click"
                            AutomationProperties.Name="{Binding Titulo, StringFormat=Importar {0}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú lateral -->
            <ColumnDefinition Width="240"/>

            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!-- MENÚ LATERAL            -->
        <!-- ======================= -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <!-- Perfil inferior -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,15"
                               Background="{StaticResource BordeBrush}"/>

                    <TextBlock Text="MI CUENTA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,5,0,15"/>

                    <Button Content="Mi perfil"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="Cerrar sesión"
                            Style="{StaticResource SidebarButtonStyle}"/>

                </StackPanel>

                <!-- Navegación -->
                <StackPanel>

                    <!-- Logotipo oficial -->
                    <Image Source="/Assets/Images/logo_blanco.png"
                           Width="200"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                    <TextBlock Text="NAVEGACIÓN"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,0,0,15"/>

                    <!-- INICIO -->
                    <Button Content="Inicio"
                            x:Name="BtnInicio"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Inicio_Click"/>

                    <!-- MI CATÁLOGO -->
                    <Button Content="Mi catálogo"
                            x:Name="BtnCatalogo"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Catalogo_Click"/>

                    <!-- RESEÑAS -->
                    <Button Content="Reseñas"
                            x:Name="BtnResenas"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Resenas_Click"/>

                    <Button Content="Créditos"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Creditos_Click"/>


                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================= -->
        <!-- CONTENIDO PRINCIPAL     -->
        <!-- ======================= -->

        <Grid Grid.Column="1" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="LogoFondo"
                   Source="/Assets/Images/logo_blanco.png"
                   Stretch="Uniform"
                   Opacity="0.055"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.16" ScaleY="1.16"/>
                        <RotateTransform Angle="-15"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>



        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="Bienvenido a FanVerse"
                           Foreground="{StaticResource MarfilBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- ======================= -->
            <!-- PESTAÑAS PRINCIPALES    -->
            <!-- ======================= -->

            <TabControl x:Name="MainTabs"
            Grid.Row="1"
            SelectedIndex="0"
            Style="{StaticResource HiddenTabsStyle}">

                <!-- INICIO: TMDB -->
                <TabItem Header="Inicio">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24">
                            <TextBlock Text="Descubre tu próxima historia"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"/>

                            <views:BuscadorTmdb Margin="0,14,0,0"/>

                            <TextBlock x:Name="EstadoImportacionInicio"
                                       Style="{StaticResource EstadoDialogo}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Margin="0,6,0,0"/>

                            <Button x:Name="ActualizarInicioButton"
                    Content="Actualizar rankings"
                    HorizontalAlignment="Left"
                    Style="{StaticResource BotonDialogo}"
                    MinHeight="34" Padding="12,6"
                    Margin="0,12,0,0"
                    Click="ActualizarInicio_Click"/>

                            <TextBlock x:Name="EstadoInicioTextBlock"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

                            <TextBlock Text="Películas mejor valoradas"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,20,0,10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PeliculasRankingItems"
                              ItemsPanel="{StaticResource FilaTmdb}"
                              ItemTemplate="{StaticResource TarjetaTmdb}"/>
                            </ScrollViewer>

                            <TextBlock Text="Series mejor valoradas"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,24,0,10"/>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SeriesRankingItems"
                              ItemsPanel="{StaticResource FilaTmdb}"
                              ItemTemplate="{StaticResource TarjetaTmdb}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- MI CATÁLOGO: FIREBASE -->
                <TabItem Header="Mi catálogo">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Mi catálogo"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource MarfilBrush}"
                       Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="Buscar en TMDB"
                                        AutomationProperties.HelpText="Busca títulos de The Movie Database para añadirlos."
                                        Style="{StaticResource BotonPrincipalDialogo}"
                                        Margin="0,0,8,6" Click="AbrirBusquedaTmdb_Click"/>
                                <Button Content="Buscar en mi catálogo"
                                        AutomationProperties.HelpText="Busca entre los títulos que ya has guardado."
                                        Style="{StaticResource BotonDialogo}"
                                        Margin="0,0,18,6" Click="AbrirBusquedaCatalogo_Click"/>
                                <Button Content="+ Añadir manualmente"
                                        Style="{StaticResource BotonDialogo}"
                                        Margin="0,0,8,6" Click="AnadirContenido_Click"/>
                                <Button Content="Editar" Style="{StaticResource BotonDialogo}"
                                        Margin="0,0,8,6" Click="EditarContenido_Click"/>
                                <Button x:Name="EliminarContenidoButton" Content="Eliminar"
                                        Style="{StaticResource BotonDialogo}"
                                        Margin="0,0,8,6" Click="EliminarContenido_Click"/>
                            </WrapPanel>

                            <TextBlock x:Name="EstadoCatalogoTextBlock"
                       Foreground="{StaticResource MarfilBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ListBox x:Name="CatalogoListBox"
                 Grid.Row="1"
                 SelectedValuePath="Key"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,12,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tarjeta"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BordeBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource MarfilBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource AmarilloBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tarjeta"
                                                Property="BorderBrush"
                                                Value="{StaticResource RojoBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="156">
                                        <ContentPresenter Content="{Binding Value}"
                                                          ContentTemplate="{StaticResource PortadaFanVerse}"/>

                                        <TextBlock Text="{Binding Value.Titulo}"
                                   Foreground="{StaticResource MarfilBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Value.Titulo}"
                                   Margin="0,8,0,5"/>

                                        <Border Background="{StaticResource CarbonBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Padding="7,3">
                                            <TextBlock x:Name="EtiquetaTipo"
                                       Text="Sin tipo"
                                       FontSize="11"
                                       Foreground="{StaticResource AmarilloBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Value.Tipo}" Value="pelicula">
                                            <Setter TargetName="EtiquetaTipo" Property="Text" Value="Película"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Value.Tipo}" Value="serie">
                                            <Setter TargetName="EtiquetaTipo" Property="Text" Value="Serie"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- RESEÑAS PÚBLICAS -->
                <TabItem Header="Reseñas">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="RESEÑAS DE LA COMUNIDAD"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Descubre las opiniones de otros usuarios."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <Button Content="+ Escribir reseña"
                                    Width="180"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RojoBrush}"
                                    Foreground="White"/>


                        </StackPanel>

                    </Grid>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>
