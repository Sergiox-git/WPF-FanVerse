<Window x:Class="FanVerse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FanVerse"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource CarbonBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú lateral -->
            <ColumnDefinition Width="240"/>

            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!-- MENÚ LATERAL            -->
        <!-- ======================= -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BordeBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <!-- Perfil inferior -->
                <StackPanel DockPanel.Dock="Bottom">

                    <Separator Margin="0,15"
                               Background="{StaticResource BordeBrush}"/>

                    <TextBlock Text="MI CUENTA"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,5,0,15"/>

                    <Button Content="Mi perfil"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="Cerrar sesión"
                            Style="{StaticResource SidebarButtonStyle}"/>

                </StackPanel>

                <!-- Navegación -->
                <StackPanel>

                    <!-- Logotipo oficial -->
                    <Image Source="/Assets/Images/logo_blanco.png"
                           Width="200"
                           Height="100"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>

                    <TextBlock Text="NAVEGACIÓN"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AmarilloBrush}"
                               Margin="10,0,0,15"/>

                    <!-- INICIO -->
                    <Button Content="Inicio"
                            x:Name="BtnInicio"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Inicio_Click"/>

                    <!-- MI CATÁLOGO -->
                    <Button Content="Mi catálogo"
                            x:Name="BtnCatalogo"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Catalogo_Click"/>

                    <!-- RESEÑAS -->
                    <Button Content="Reseñas"
                            x:Name="BtnResenas"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="Resenas_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================= -->
        <!-- CONTENIDO PRINCIPAL     -->
        <!-- ======================= -->

        <Grid Grid.Column="1" Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="FANVERSE"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource MarfilBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Bienvenido a FanVerse"
                           Foreground="{StaticResource MarfilBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </Grid>

            <!-- ======================= -->
            <!-- PESTAÑAS PRINCIPALES    -->
            <!-- ======================= -->

            <TabControl x:Name="MainTabs"
            Grid.Row="1"
            SelectedIndex="0"
            Style="{StaticResource HiddenTabsStyle}">

                <!-- INICIO: TMDB -->
                <TabItem Header="Inicio">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="DESCUBRE TU PRÓXIMA HISTORIA"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Explora películas y series de TMDB."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <TextBox Height="40"
                                     Width="400"
                                     HorizontalAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     Padding="12,0"
                                     Text="Buscar películas y series..."/>

                        </StackPanel>

                    </Grid>

                </TabItem>

                <!-- MI CATÁLOGO: FIREBASE -->
                <TabItem Header="Mi catálogo">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="MI CATÁLOGO"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Gestiona tus películas y series guardadas."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <Button Content="+ Añadir película o serie"
                                    Width="220"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RojoBrush}"
                                    Foreground="White"
                                    Click="AnadirContenido_Click"/>

                            <Button Content="Editar"
                                     Height="42"
                                     Width="220"
                                     Margin="0,8,0,0"
                                     HorizontalAlignment="Left"
                                     Click="EditarContenido_Click"/>

                            <TextBlock x:Name="EstadoCatalogoTextBlock"
                                        Foreground="{StaticResource MarfilBrush}"
                                        Margin="0,12,0,6"
                                        TextWrapping="Wrap" />

                            <ListBox x:Name="CatalogoListBox"
                                        DisplayMemberPath="Value.Titulo"
                                        SelectedValuePath="Key"
                                        MaxHeight="320" />

                        </StackPanel>

                    </Grid>

                </TabItem>

                <!-- RESEÑAS PÚBLICAS -->
                <TabItem Header="Reseñas">

                    <Grid Background="{StaticResource CarbonBrush}"
                          Margin="20">

                        <StackPanel>

                            <TextBlock Text="RESEÑAS DE LA COMUNIDAD"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Descubre las opiniones de otros usuarios."
                                       FontSize="16"
                                       Foreground="{StaticResource MarfilBrush}"
                                       Margin="0,0,0,30"/>

                            <Button Content="+ Escribir reseña"
                                    Width="180"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RojoBrush}"
                                    Foreground="White"/>

                        </StackPanel>

                    </Grid>

                </TabItem>

            </TabControl>

        </Grid>

    </Grid>
</Window>
